{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Academic Asset Portal",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "FLASK_ENV": "development",
                "PORT": "5000"
            }
        },
        {
            "name": "Python: Run Seed Database",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/seed_data.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Run Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_app.py",
            "console": "integratedTerminal"
        }
    ]
}
