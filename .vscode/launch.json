{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run All-in-One Single File (Guide Demo)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/single_file_academic_system.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PORT": "5000"
            }
        },
        {
            "name": "Python: Run Modular Web Portal (app.py)",
